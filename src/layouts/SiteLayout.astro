---
import { site, absoluteUrl, availableImage } from '../lib/site.mjs';
import '../styles/site.css';
interface Props { title?: string; description?: string; image?: string; article?: boolean; date?: string; noindex?: boolean; }
const { title, description = site.description, image, article = false, date, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.siteName}` : site.siteName;
const canonical = absoluteUrl(Astro.url.pathname);
const socialImage = availableImage(image) || availableImage(site.logoPath);
---
<!doctype html>
<html lang={site.language} style={`--ink:${site.colors.ink};--accent:${site.colors.accent};--paper:${site.colors.paper}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.colors.paper} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.siteName} stories`} href="/rss.xml" />
    {site.logoPath && <link rel="icon" href={site.logoPath} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={title || site.siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={absoluteUrl(socialImage)} />}
    {article && date && <meta property="article:published_time" content={`${date}T00:00:00Z`} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">
          {site.logoPath && <img src={site.logoPath} alt="" width="40" height="40" />}
          <span>{site.siteName}</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
          <a href={site.routePrefix} aria-current={Astro.url.pathname.startsWith(site.routePrefix) ? 'page' : undefined}>Stories</a>
          <a class="feed-link" href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell">
      <a class="brand" href="/">{site.siteName}</a>
      <p>© {new Date().getFullYear()} {site.companyName}</p>
      <a href={site.routePrefix}>Explore the journal <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>
