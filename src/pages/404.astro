---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../lib/site.mjs';
---
<SiteLayout title="Page not found" noindex>
  <div class="shell not-found"><p class="eyebrow">404 / Page not found</p><h1>This page has drifted away.</h1><p>It may have moved, or the address may be incomplete.</p><a class="button" href={site.routePrefix}>Explore stories ↗</a></div>
</SiteLayout>
